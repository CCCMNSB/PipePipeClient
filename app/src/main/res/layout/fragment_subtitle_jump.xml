<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Channel-style top tabs: 视频 / 合集. Hidden while the manifest has no collections.
         Styled like fragment_channel.xml (colorPrimary background, white tab text + indicator). -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/subtitle_jump_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:visibility="gone"
        app:tabIndicatorColor="@color/white"
        app:tabMode="scrollable"
        app:tabRippleColor="@color/white"
        app:tabTextColor="@color/white"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/subtitle_jump_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/subtitle_jump_search_hint"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:imeOptions="actionSearch"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/subtitle_jump_clear_cache"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/subtitle_cache_category_title"
            android:padding="10dp"
            android:src="@drawable/ic_delete"
            app:tint="?attr/colorAccent" />

        <ImageButton
            android:id="@+id/subtitle_jump_refresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/subtitle_jump_refresh_hint"
            android:padding="10dp"
            android:src="@drawable/ic_refresh"
            app:tint="?attr/colorAccent" />
    </LinearLayout>

    <!-- Active collection filter (video tab only): chip with the collection name + clear button. -->
    <LinearLayout
        android:id="@+id/subtitle_jump_filter_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.chip.Chip
            android:id="@+id/subtitle_jump_filter_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:textColor="?attr/tag_text_color"
            android:textSize="13sp"
            android:theme="@style/Theme.MaterialComponents.DayNight.Bridge"
            app:chipBackgroundColor="?attr/card_item_contrast_color"
            tools:text="Acacia放送局" />

        <ImageButton
            android:id="@+id/subtitle_jump_filter_clear"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/subtitle_jump_clear_filter"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorAccent" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/subtitle_jump_swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/subtitle_jump_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_subtitle_jump" />

        <ProgressBar
            android:id="@+id/subtitle_jump_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/subtitle_jump_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textSize="16sp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="未找到字幕清单" />

        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </FrameLayout>

    <Button
        android:id="@+id/subtitle_jump_load_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/subtitle_jump_load_more"
        android:visibility="gone" />

</LinearLayout>
