<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
                  xmlns:app="http://schemas.android.com/apk/res-auto"
                  android:key="general_preferences"
                  android:title="@string/settings_category_bullet_comments_summary">
    <!--preference compat where user can use a seekbar to select regular bullet comments duration between 5s to 15s-->
    <!--        default value should be 8s-->
    <SeekBarPreference
            android:defaultValue="8"
            android:key="@string/regular_bullet_comments_duration_key"
            android:max="15"
            android:summary="@string/regular_bullet_comments_duration_summary"
            android:title="@string/regular_bullet_comments_duration_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />
    <!--preference compat where user can use a seekbar to select top/bottom bullet comments duration between 5s to 15s-->
    <!--        default value should be 8s-->
    <SeekBarPreference
            android:defaultValue="8"
            android:key="@string/top_bottom_bullet_comments_duration_key"
            android:max="15"
            android:summary="@string/top_bottom_bullet_comments_duration_summary"
            android:title="@string/top_bottom_bullet_comments_duration_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <SeekBarPreference
            android:defaultValue="2"
            android:key="@string/bullet_comments_outline_radius_key"
            android:max="8"
            android:title="@string/bullet_comments_outline_radius_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <SeekBarPreference
            android:defaultValue="255"
            android:key="@string/bullet_comments_opacity_key"
            android:max="255"
            android:title="@string/bullet_comments_opacity_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
            android:key="@string/enable_max_rows_customization_key"
            android:title="@string/enable_max_rows_customization_title"
            android:summary="@string/enable_max_rows_customization_summary"
            android:defaultValue="false"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false"/>


    <SeekBarPreference
            android:defaultValue="15"
            android:key="@string/max_bullet_comments_rows_top_key"
            android:max="15"
            android:title="@string/max_bullet_comments_rows_top_summary"
            android:summary="%s"
            app:singleLineTitle="false"
            app:dependency="@string/enable_max_rows_customization_key"
            app:iconSpaceReserved="false" />

    <SeekBarPreference
            android:defaultValue="15"
            android:key="@string/max_bullet_comments_rows_bottom_key"
            android:max="15"
            android:title="@string/max_bullet_comments_rows_bottom_summary"
            android:summary="%s"
            app:singleLineTitle="false"
            app:dependency="@string/enable_max_rows_customization_key"
            app:iconSpaceReserved="false" />

    <SeekBarPreference
            android:defaultValue="15"
            android:key="@string/max_bullet_comments_rows_regular_key"
            android:max="15"
            android:title="@string/max_bullet_comments_rows_regular_summary"
            android:summary="%s"
            app:singleLineTitle="false"
            app:dependency="@string/enable_max_rows_customization_key"
            app:iconSpaceReserved="false" />

    <ListPreference
            android:key="@string/bullet_comments_font_key"
            android:entries="@array/font_list"
            android:entryValues="@array/font_list"
            android:defaultValue="LXGW WenKai Screen"
            android:title="@string/bullet_comments_font_title"
            android:summary="%s"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false"/>

    <PreferenceCategory
            android:title="@string/danmaku_translation_category"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
                android:key="@string/danmaku_show_original_key"
                android:title="@string/danmaku_show_original_title"
                android:summary="@string/danmaku_show_original_summary"
                android:defaultValue="true"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false"/>

        <ListPreference
                android:key="@string/danmaku_translation_provider_key"
                android:title="@string/danmaku_translation_provider_title"
                android:entries="@array/danmaku_translation_provider_entries"
                android:entryValues="@array/danmaku_translation_provider_values"
                android:defaultValue="llm"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false"/>

        <ListPreference
                android:key="@string/danmaku_translation_target_lang_key"
                android:title="@string/danmaku_translation_target_lang_title"
                android:entries="@array/danmaku_translation_target_lang_entries"
                android:entryValues="@array/danmaku_translation_target_lang_values"
                android:defaultValue="zh-CN"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false"/>

        <ListPreference
                android:key="@string/danmaku_source_lang_key"
                android:title="@string/danmaku_source_lang_title"
                android:summary="@string/danmaku_source_lang_summary"
                android:entries="@array/danmaku_source_lang_entries"
                android:entryValues="@array/danmaku_source_lang_values"
                android:defaultValue="auto"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false"/>

        <ListPreference
                android:key="@string/danmaku_progress_interval_key"
                android:title="@string/danmaku_progress_interval_title"
                android:summary="%s"
                android:entries="@array/danmaku_progress_interval_entries"
                android:entryValues="@array/danmaku_progress_interval_values"
                android:defaultValue="100"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false"/>

        <EditTextPreference
                android:key="@string/llm_base_url_key"
                android:title="@string/llm_base_url_title"
                android:defaultValue="https://api.deepseek.com"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false"/>

        <EditTextPreference
                android:key="@string/llm_api_key_key"
                android:title="@string/llm_api_key_title"
                android:defaultValue=""
                app:singleLineTitle="false"
                app:iconSpaceReserved="false"/>

        <EditTextPreference
                android:key="@string/llm_model_key"
                android:title="@string/llm_model_title"
                android:defaultValue="deepseek-chat"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false"/>

        <ListPreference
                android:key="@string/danmaku_llm_source_key"
                android:title="@string/danmaku_llm_source_title"
                android:summary="@string/danmaku_llm_source_summary"
                android:entries="@array/danmaku_llm_source_entries"
                android:entryValues="@array/danmaku_llm_source_values"
                android:defaultValue="cloud"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false"/>

        <EditTextPreference
                android:key="@string/danmaku_llm_local_base_url_key"
                android:title="@string/danmaku_llm_local_base_url_title"
                android:defaultValue=""
                app:singleLineTitle="false"
                app:iconSpaceReserved="false"/>

        <EditTextPreference
                android:key="@string/danmaku_llm_local_model_key"
                android:title="@string/danmaku_llm_local_model_title"
                android:defaultValue="qwen2.5:7b"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false"/>

        <EditTextPreference
                android:key="@string/danmaku_llm_local_key_key"
                android:title="@string/danmaku_llm_local_key_title"
                android:defaultValue="ollama"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
            android:title="@string/danmaku_cache_category_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false">

        <Preference
                android:key="@string/danmaku_cache_key"
                android:title="@string/danmaku_cache_manage_title"
                android:summary=""
                app:singleLineTitle="false"
                app:iconSpaceReserved="false"/>

    </PreferenceCategory>

    <PreferenceCategory
            android:key="subtitle_category"
            android:title="@string/subtitle_category_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
                android:key="@string/subtitle_enable_key"
                android:title="@string/subtitle_enable_title"
                android:summary="@string/subtitle_enable_summary"
                android:defaultValue="true"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false"/>

        <EditTextPreference
                android:key="@string/subtitle_base_url_key"
                android:title="@string/subtitle_base_url_title"
                android:summary="@string/subtitle_base_url_summary"
                android:defaultValue="https://raw.githubusercontent.com/CCCMNSB/subtitles/main/subtitles"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false"/>

        <ListPreference
                android:key="@string/subtitle_font_key"
                android:title="@string/subtitle_font_title"
                android:summary="%s"
                android:entries="@array/subtitle_font_entries"
                android:entryValues="@array/subtitle_font_values"
                android:defaultValue="@string/subtitle_font_default_value"
                app:singleLineTitle="false"
                app:iconSpaceReserved="false"/>
    </PreferenceCategory>
</PreferenceScreen>